__pycache__/
*.py[cod]
.venv/
venv/
# Stray root logs only (D8: top-level *.log/*.out never belong in git).
# NOTE: `logs/` is deliberately NOT ignored (D22: run logs are tracked in
# every repo) -- this repo was the last holdout, and its daily driver had
# been trying to `git add logs/` the whole time, which git rejected because
# the whole pathspec named an ignored path.
/*.log
/*.out
.pytest_cache/
.ruff_cache/
.mypy_cache/
# local-only proxy creds / canary output (mirrors ncaa-mbb-hoops-raw)
/canary_vendors.toml
/canary_out/
/.ncaa_fetch_cache/

# oh-my-claudecode tool artifacts
.omc/
